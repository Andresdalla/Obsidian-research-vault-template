filters:
  and:
    - categories.contains(link("Tools"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.language:
    displayName: Language
  note.url:
    displayName: URL
  note.github:
    displayName: GitHub
views:
  - type: table
    name: Tools
    order:
      - file.name
      - type
      - language
      - topics
      - url
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Type
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - language
      - url
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Language
    filters:
      and:
        - list(language).contains(this)
    order:
      - file.name
      - type
      - url
    sort:
      - property: file.name
        direction: ASC
