filters:
  and:
    - categories.contains(link("Courses"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.instructor:
    displayName: Instructor
  note.platform:
    displayName: Platform
  note.field:
    displayName: Field
  note.rating:
    displayName: Rating
views:
  - type: table
    name: Courses
    order:
      - file.name
      - instructor
      - platform
      - field
      - rating
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: To Take
    filters:
      and:
        - file.tags.contains("to-take")
    order:
      - file.name
      - instructor
      - platform
      - field
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: In Progress
    filters:
      and:
        - file.tags.contains("in-progress")
    order:
      - file.name
      - instructor
      - platform
      - field
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Completed
    filters:
      and:
        - file.tags.contains("completed")
    order:
      - file.name
      - instructor
      - rating
      - field
    sort:
      - property: note.rating
        direction: DESC
  - type: table
    name: Field
    filters:
      and:
        - list(field).contains(this)
    order:
      - file.name
      - instructor
      - platform
      - rating
    sort:
      - property: file.name
        direction: ASC
