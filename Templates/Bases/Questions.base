filters:
  and:
    - categories.contains(link("Questions"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Question
  note.field:
    displayName: Field
  note.created:
    displayName: Created
views:
  - type: table
    name: Questions
    order:
      - file.name
      - field
      - topics
      - created
    sort:
      - property: note.created
        direction: DESC
  - type: table
    name: Open
    filters:
      and:
        - file.tags.contains("open")
    order:
      - file.name
      - field
      - created
    sort:
      - property: note.created
        direction: DESC
  - type: table
    name: Investigating
    filters:
      and:
        - file.tags.contains("investigating")
    order:
      - file.name
      - field
      - created
    sort:
      - property: note.created
        direction: DESC
  - type: table
    name: Answered
    filters:
      and:
        - file.tags.contains("answered")
    order:
      - file.name
      - field
      - answer-note
    sort:
      - property: note.created
        direction: DESC
  - type: table
    name: Field
    filters:
      and:
        - list(field).contains(this)
    order:
      - file.name
      - topics
      - created
    sort:
      - property: note.created
        direction: DESC
