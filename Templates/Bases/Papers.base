filters:
  and:
    - categories.contains(link("Papers"))
    - '!file.name.contains("Template")'
properties:
  note.author:
    displayName: Author
  file.name:
    displayName: Title
  note.year:
    displayName: Year
  note.venue:
    displayName: Venue
  note.field:
    displayName: Field
  note.rating:
    displayName: Rating
views:
  - type: table
    name: Papers
    order:
      - file.name
      - author
      - year
      - field
      - rating
      - topics
    sort:
      - property: note.year
        direction: DESC
  - type: table
    name: To Read
    filters:
      and:
        - file.tags.contains("to-read")
    order:
      - file.name
      - author
      - field
      - topics
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Read
    filters:
      and:
        - file.tags.contains("read")
    order:
      - file.name
      - author
      - year
      - rating
      - field
    sort:
      - property: note.rating
        direction: DESC
  - type: table
    name: Author
    filters:
      and:
        - list(author).contains(this)
    order:
      - file.name
      - year
      - venue
      - field
    sort:
      - property: note.year
        direction: DESC
  - type: table
    name: Field
    filters:
      and:
        - list(field).contains(this)
    order:
      - file.name
      - author
      - year
      - rating
    sort:
      - property: note.year
        direction: DESC
  - type: table
    name: Venue
    filters:
      and:
        - list(venue).contains(this)
    order:
      - file.name
      - author
      - year
    sort:
      - property: note.year
        direction: DESC
